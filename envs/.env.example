# ================================
# Environment
# ================================
NODE_ENV=development

# Used only in development to load specific environment config
LOAD_ENV=development


# ================================
# WhatsApp Configuration
# ================================
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
WHATSAPP_TOKEN=your_whatsapp_token
PHONE_NUMBER_ID=your_phone_number_id
VERIFY_TOKEN=your_verify_token

# WhatsApp token is auto-refreshed on startup and every 7 days.
# META_APP_ID and META_APP_SECRET are required for the refresh.


# ================================
# Google Sheets
# ================================
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id
DEFAULT_LEARNER_LOCATION=your_default_location


# ================================
# Google OAuth2 Configuration
# ================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=https://your-domain.com/auth/oauth2callback
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_MAPS_API_KEY=your_google_maps_api_key


# ================================
# Server Configuration
# ================================
PORT=3000
FRONTEND_URL=http://localhost:8080
PORTAL_URL=http://localhost:5173

# ================================
# Dashboard Configuration
# ================================
# Must match the JWT_SECRET used by the Donna website server
JWT_SECRET=your-jwt-secret-change-me
DEFAULT_LESSON_RATE=50
MONTHLY_REVENUE_TARGET=3000


# ================================
# Database Configuration
# ================================
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name
DB_NAME=your_database_name


# ================================
# AI Configuration
# ================================
# OPENAI_API_KEY=your_openai_api_key
GOOGLE_AI_API_KEY=your_google_ai_api_key


# ================================
# Cloudflare R2 Configuration
# ================================
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com/
R2_DIRECTORY=your_directory_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name


# ================================
# Instructor Location Defaults
# ================================
LATUTIDE_DEFAULT=00.000000
LONGITUDE_DEFAULT=00.000000


# ================================
# Instructor Details
# ================================
INSTRUCTOR_NAME=your_instructor_name
INSTRUCTOR_EMAIL=your_instructor_email
INSTRUCTOR_PHONE=your_instructor_personal_phone


# ================================
# Email Notifications (invalid_grant alerts)
# ================================
# Uses Gmail + App Password (free). Generate an App Password at:
# Google Account > Security > 2-Step Verification > App Passwords
NOTIFY_EMAIL_USER=yourbot@gmail.com
NOTIFY_EMAIL_PASS=abcd-efgh-ijkl-mnop
NOTIFY_EMAIL_TO=your-personal@gmail.com
BASE_URL=https://your-domain.com


# ================================
# Application Configuration
# ================================
APP_TIMEZONE=Asia/Kolkata
SESSION_TIMEOUT_MINUTES=60
CONTEXT_TIMEOUT_MINUTES=5
WAIT_FOR_R2_IN_MINS=1


# ================================
# Logger Configuration
# ================================
LOGS_ADMIN_PASSWORD=your_logs_admin_password