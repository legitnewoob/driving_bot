{
  "name": "whatsapp-driving-bot",
  "version": "1.1.0",
  "description": "WhatsApp bot for driving test bookings",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --verbose --testPathIgnorePatterns=tests/e2e",
    "test:unit": "jest --verbose tests/unit",
    "test:integration": "jest --verbose tests/integration",
    "test:route": "jest --verbose tests/integration/routeOptimizer",
    "test:coverage": "jest --coverage --collectCoverageFrom=\"src/**/*.js\" --testPathIgnorePatterns=tests/e2e",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --verbose --config jest.config.e2e.js",
    "test:e2e:report": "cross-env NODE_OPTIONS=--experimental-vm-modules EMAIL_REPORT=1 jest --verbose --config jest.config.e2e.js",
    "instructor:add": "node scripts/seedInstructor.js add",
    "instructor:list": "node scripts/seedInstructor.js list",
    "instructor:update": "node scripts/seedInstructor.js update",
    "instructor:delete": "node scripts/seedInstructor.js delete"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.4.0",
    "chalk": "^5.6.0",
    "chrono-node": "^2.8.4",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^8.2.1",
    "googleapis": "^171.4.0",
    "inquirer": "^9.3.7",
    "moment-timezone": "^0.6.0",
    "mongodb": "^6.21.0",
    "mongoose": "^8.17.2",
    "nanoid": "^3.3.11",
    "nodemailer": "^8.0.7",
    "openai": "^5.12.2",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "commitlint": "^20.4.3",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.11",
    "semantic-release": "^25.0.3"
  }
}
