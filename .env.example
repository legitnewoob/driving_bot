# ─── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_TIMEZONE=Europe/London

# ─── MongoDB ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/driving_bot

# ─── Google APIs ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/oauth2callback
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── Meta / WhatsApp ─────────────────────────────────────────────────────
# Used by refreshWhatsappToken to exchange tokens via Meta Graph API.
# One shared token is used for all instructors; it is refreshed on startup
# and every 7 days automatically.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# ─── Instructor Seeding (scripts/seedInstructor.js) ──────────────────────
# PHONE_NUMBER_ID=whatsapp-phone-number-id
# INSTRUCTOR_PHONE=personal-phone-for-oauth
# INSTRUCTOR_NAME=Instructor Name
# INSTRUCTOR_EMAIL=instructor@example.com
# GOOGLE_REFRESH_TOKEN=google-refresh-token
# WHATSAPP_TOKEN=initial-whatsapp-token
# GOOGLE_SPREADSHEET_ID=spreadsheet-id
# LATITUDE_DEFAULT=53.0168
# LONGITUDE_DEFAULT=-2.2191

# ─── Webhook Verification ────────────────────────────────────────────────
VERIFY_TOKEN=your-webhook-verify-token

# ─── Logging ─────────────────────────────────────────────────────────────
# LOG_LEVEL=info
